# Conexao com o Postgres
PNCP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pncp

# Ritmo das requisicoes
PNCP_REQUEST_DELAY=0.5
PNCP_MAX_RETRIES=5

# Contrato derivado de ata ja coletada: por padrao e mantido e apenas marcado.
# Ligue para descarta-lo da amostra.
# PNCP_DISCARD_DERIVED_CONTRACTS=true

# Recortes opcionais
# PNCP_CNPJ=18457226000181
# PNCP_CODIGO_UNIDADE_ADMINISTRATIVA=1

# Fase 2 (detalhamento). A API de detalhe e lenta (~8 s por chamada) e nao
# limita taxa; ver docs/API_DETALHE.md, § 1.6.
# Threads nas chamadas de detalhe (1 a 8). Com 1, um orgao de ~900 capas leva
# ~15 h; com 8, ~2 h.
PNCP_DETAIL_CONCURRENCY=4
# Delay apos cada chamada de detalhe; vazio = PNCP_REQUEST_DELAY.
# PNCP_DETAIL_REQUEST_DELAY=0.5
# Documento/compra em erro deixa de ser revisitado apos N tentativas.
PNCP_DETAIL_MAX_ATTEMPTS=5
# tamanhoPagina de /itens (a API pagina com default 10).
# PNCP_DETAIL_PAGE_SIZE=500

# Tipos de arquivo (tipoDocumentoNome) que contam como "arquivo alvo", separados
# por virgula. Vazio = qualquer arquivo conta. Os defaults vem da medicao em
# docs/API_DETALHE.md: atas vem 100% como "Outros Documentos", e contrato-por-
# empenho so tem a nota de empenho.
# PNCP_TARGET_FILE_TYPES_ATA=
# PNCP_TARGET_FILE_TYPES_CONTRATO=Contrato,Nota de Empenho
