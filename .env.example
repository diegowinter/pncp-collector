# Conexao com o Postgres
PNCP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pncp

# Ritmo das requisicoes
PNCP_REQUEST_DELAY=0.5
PNCP_MAX_RETRIES=5

# Contrato derivado de ata ja coletada: por padrao e mantido e apenas marcado.
# Ligue para descarta-lo da amostra.
# PNCP_DISCARD_DERIVED_CONTRACTS=true

# Recortes opcionais
